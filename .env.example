# MongoDB Atlas connection string. Keep secrets out of Git.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/maison_belle
# Generate a random secret of at least 32 characters.
OWNER_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
OWNER_EMAIL=owner@example.com
# Generate with: node -e "require('bcryptjs').hash('your-password', 12).then(console.log)"
OWNER_PASSWORD_HASH=replace-with-bcrypt-hash
# Public salon details are placeholders until the owner confirms them.
NEXT_PUBLIC_SALON_NAME=Maison Belle
NEXT_PUBLIC_SALON_PHONE=
NEXT_PUBLIC_SALON_ADDRESS=
